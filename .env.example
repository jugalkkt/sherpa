# Model
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Remote Ollama behind a tunnel (e.g. ngrok + Kaggle): "user:pass". Leave empty for local.
OLLAMA_BASIC_AUTH=

# Storage
CHECKPOINT_DB=data/checkpoints.db
NOTES_PATH=study_materials/sample_notes

# Langfuse (leave empty to run without tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Evals (make eval)
# Optional: a different model to grade answers (defaults to OLLAMA_MODEL).
OLLAMA_JUDGE_MODEL=
# deepeval sends telemetry (public IP lookup, Sentry, PostHog) unless opted out.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# A2A
QUIZ_SERVICE_URL=http://localhost:9001
STUDY_BUDDY_URL=http://localhost:9002
USE_A2A_QUIZ=true
USE_STUDY_BUDDY=true

# Hosting (web app + Kaggle model server; see docs/DEPLOYMENT.md)
APP_PASSWORD=
NGROK_AUTHTOKEN=
KAGGLE_KERNEL_SLUG=yourname/sherpa-ollama-server
KAGGLE_SECRETS_DATASET=yourname/sherpa-server-secrets
SERVER_IDLE_MINUTES=10
SERVER_MAX_HOURS=3
# KAGGLE_API_TOKEN=   # only when hosted; locally ~/.kaggle/access_token is used
